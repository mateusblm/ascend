{
  "name": "ascend-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/account-authority.test.js test/competitive-quest-authority.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-ascend --only firestore \"node --test test/firestore-rules.test.js\"",
    "deploy": "firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.7.1",
    "firebase-tools": "^14.0.1",
    "typescript": "^5.6.3"
  }
}
