rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /weekly_bosses/{bossId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /completions/{userId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;

      match /progression/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /profile/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /quests/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /quests_meta/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /quest_completions/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /weekly_boss_claims/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /attribute_allocations/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /session/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /progression_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /promotion_exam/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /season_rewards/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /season_reward_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /season_legacy/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /season_profile/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /integrity/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /integrity_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /competitive_quest_grants/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /competitive_quest_sessions/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /competitive_quest_evidence/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /reading_quiz_attempts/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }
  }
}
