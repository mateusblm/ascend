rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function completionPath(bossId, userId) {
      return /databases/$(database)/documents/weekly_bosses/$(bossId)/completions/$(userId);
    }

    function isValidRank(rank) {
      return rank in ['E', 'D', 'C', 'B', 'A', 'S'];
    }

    function isValidSyncSource(source) {
      return source in ['client', 'debug', 'backend'];
    }

    function isValidRankStatus(status) {
      return status in ['secure', 'warning', 'critical', 'promotionReady', 'demoted'];
    }

    function isValidRankEventType(eventType) {
      return eventType in [
        'routine',
        'warning',
        'perfectWeek',
        'promotionUnlocked',
        'reconquestUnlocked',
        'promotionConfirmed',
        'demotionApplied'
      ];
    }

    function isValidExamStatus(status) {
      return status in ['inProgress', 'passed', 'failed', 'promoted'];
    }

    function isValidExamMode(mode) {
      return mode in ['ascension', 'reconquest'];
    }

    function isValidSeasonRewardClaimStatus(status) {
      return status in ['locked', 'readyToClaim', 'claimed'];
    }

    function isValidTrustBand(band) {
      return band in ['high', 'stable', 'attention', 'restricted'];
    }

    function validProgressionSnapshot(docId, shouldMatchDocId) {
      return request.resource.data.keys().hasOnly([
            'currentRank',
            'peakRank',
            'highestEligibleRank',
            'weekKey',
            'activeDays',
            'requiredActiveDays',
            'requiresBossClear',
            'bossCompleted',
            'status',
            'demotionStrikes',
            'promotionReady',
            'promotionTargetRank',
            'targetRequiredLevel',
            'targetLevelGateMet',
            'advancementMode',
            'eventType',
            'summary',
            'detail',
            'syncSchemaVersion',
            'syncSource',
            'updatedAt'
          ]) &&
          isValidRank(request.resource.data.currentRank) &&
          isValidRank(request.resource.data.peakRank) &&
          isValidRank(request.resource.data.highestEligibleRank) &&
          request.resource.data.weekKey is string &&
          (!shouldMatchDocId || request.resource.data.weekKey == docId) &&
          request.resource.data.activeDays is int &&
          request.resource.data.activeDays >= 0 &&
          request.resource.data.requiredActiveDays is int &&
          request.resource.data.requiredActiveDays >= 0 &&
          request.resource.data.requiresBossClear is bool &&
          request.resource.data.bossCompleted is bool &&
          isValidRankStatus(request.resource.data.status) &&
          request.resource.data.demotionStrikes is int &&
          request.resource.data.demotionStrikes >= 0 &&
          request.resource.data.promotionReady is bool &&
          (request.resource.data.promotionTargetRank == null ||
              isValidRank(request.resource.data.promotionTargetRank)) &&
          request.resource.data.targetRequiredLevel is int &&
          request.resource.data.targetRequiredLevel >= 1 &&
          request.resource.data.targetLevelGateMet is bool &&
          (request.resource.data.advancementMode == null ||
              isValidExamMode(request.resource.data.advancementMode)) &&
          isValidRankEventType(request.resource.data.eventType) &&
          request.resource.data.summary is string &&
          request.resource.data.summary.size() <= 240 &&
          request.resource.data.detail is string &&
          request.resource.data.detail.size() <= 500 &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          request.resource.data.updatedAt is timestamp;
    }

    function validPromotionExam(docId) {
      return docId == 'current' &&
          request.resource.data.keys().hasOnly([
            'sourceRank',
            'targetRank',
            'sourceWeekKey',
            'status',
            'mode',
            'baselineActiveDays',
            'requiredExtraActiveDays',
            'bossRequired',
            'requiredLevel',
            'startedAt',
            'expiresAt',
            'syncSchemaVersion',
            'syncSource',
            'resolvedAt'
          ]) &&
          isValidRank(request.resource.data.sourceRank) &&
          isValidRank(request.resource.data.targetRank) &&
          request.resource.data.sourceWeekKey is string &&
          isValidExamStatus(request.resource.data.status) &&
          isValidExamMode(request.resource.data.mode) &&
          request.resource.data.baselineActiveDays is int &&
          request.resource.data.baselineActiveDays >= 0 &&
          request.resource.data.requiredExtraActiveDays is int &&
          request.resource.data.requiredExtraActiveDays >= 0 &&
          request.resource.data.bossRequired is bool &&
          request.resource.data.requiredLevel is int &&
          request.resource.data.requiredLevel >= 1 &&
          request.resource.data.startedAt is timestamp &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          (request.resource.data.resolvedAt == null || request.resource.data.resolvedAt is timestamp);
    }

    function validSeasonReward(docId, shouldMatchDocId) {
      return request.resource.data.keys().hasOnly([
            'seasonKey',
            'seasonLabel',
            'currentRankBracket',
            'rewardTierLabel',
            'rewardStatusLabel',
            'rewardUnlocked',
            'rewardName',
            'rewardBadgeLabel',
            'rewardTitleLabel',
            'rewardBonusLabel',
            'recordedWeeks',
            'secureWeeks',
            'seasonScore',
            'scoreBandLabel',
            'clearRateLabel',
            'playerStandingLabel',
            'spotlightLabel',
            'resetLabel',
            'claimStatus',
            'syncSchemaVersion',
            'syncSource',
            'updatedAt',
            'claimedAt'
          ]) &&
          request.resource.data.seasonKey is string &&
          (!shouldMatchDocId || request.resource.data.seasonKey == docId) &&
          request.resource.data.seasonLabel is string &&
          request.resource.data.seasonLabel.size() <= 24 &&
          isValidRank(request.resource.data.currentRankBracket) &&
          request.resource.data.rewardTierLabel is string &&
          request.resource.data.rewardTierLabel.size() <= 32 &&
          request.resource.data.rewardStatusLabel is string &&
          request.resource.data.rewardStatusLabel.size() <= 32 &&
          request.resource.data.rewardUnlocked is bool &&
          request.resource.data.rewardName is string &&
          request.resource.data.rewardName.size() <= 80 &&
          request.resource.data.rewardBadgeLabel is string &&
          request.resource.data.rewardBadgeLabel.size() <= 40 &&
          request.resource.data.rewardTitleLabel is string &&
          request.resource.data.rewardTitleLabel.size() <= 60 &&
          request.resource.data.rewardBonusLabel is string &&
          request.resource.data.rewardBonusLabel.size() <= 240 &&
          request.resource.data.recordedWeeks is int &&
          request.resource.data.recordedWeeks >= 0 &&
          request.resource.data.secureWeeks is int &&
          request.resource.data.secureWeeks >= 0 &&
          request.resource.data.seasonScore is int &&
          request.resource.data.scoreBandLabel is string &&
          request.resource.data.scoreBandLabel.size() <= 24 &&
          request.resource.data.clearRateLabel is string &&
          request.resource.data.clearRateLabel.size() <= 64 &&
          request.resource.data.playerStandingLabel is string &&
          request.resource.data.playerStandingLabel.size() <= 64 &&
          request.resource.data.spotlightLabel is string &&
          request.resource.data.spotlightLabel.size() <= 240 &&
          request.resource.data.resetLabel is string &&
          request.resource.data.resetLabel.size() <= 40 &&
          isValidSeasonRewardClaimStatus(request.resource.data.claimStatus) &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          request.resource.data.updatedAt is timestamp &&
          (request.resource.data.claimedAt == null || request.resource.data.claimedAt is timestamp);
    }

    function validSeasonLegacy(docId, shouldMatchDocId) {
      return request.resource.data.keys().hasOnly([
            'seasonKey',
            'seasonLabel',
            'claimedRankBracket',
            'rewardTierLabel',
            'rewardName',
            'rewardBadgeLabel',
            'rewardTitleLabel',
            'rewardBonusLabel',
            'scoreBandLabel',
            'seasonScore',
            'playerStandingLabel',
            'spotlightLabel',
            'cosmeticFrameLabel',
            'cosmeticAuraLabel',
            'claimedAt',
            'syncSchemaVersion',
            'syncSource',
            'updatedAt'
          ]) &&
          request.resource.data.seasonKey is string &&
          (!shouldMatchDocId || request.resource.data.seasonKey == docId) &&
          request.resource.data.seasonLabel is string &&
          request.resource.data.seasonLabel.size() <= 24 &&
          isValidRank(request.resource.data.claimedRankBracket) &&
          request.resource.data.rewardTierLabel is string &&
          request.resource.data.rewardTierLabel.size() <= 32 &&
          request.resource.data.rewardName is string &&
          request.resource.data.rewardName.size() <= 80 &&
          request.resource.data.rewardBadgeLabel is string &&
          request.resource.data.rewardBadgeLabel.size() <= 40 &&
          request.resource.data.rewardTitleLabel is string &&
          request.resource.data.rewardTitleLabel.size() <= 60 &&
          request.resource.data.rewardBonusLabel is string &&
          request.resource.data.rewardBonusLabel.size() <= 240 &&
          request.resource.data.scoreBandLabel is string &&
          request.resource.data.scoreBandLabel.size() <= 24 &&
          request.resource.data.seasonScore is int &&
          request.resource.data.playerStandingLabel is string &&
          request.resource.data.playerStandingLabel.size() <= 64 &&
          request.resource.data.spotlightLabel is string &&
          request.resource.data.spotlightLabel.size() <= 240 &&
          request.resource.data.cosmeticFrameLabel is string &&
          request.resource.data.cosmeticFrameLabel.size() <= 40 &&
          request.resource.data.cosmeticAuraLabel is string &&
          request.resource.data.cosmeticAuraLabel.size() <= 40 &&
          request.resource.data.claimedAt is timestamp &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          request.resource.data.updatedAt is timestamp;
    }

    function validSeasonProfile(docId) {
      return docId == 'current' &&
          request.resource.data.keys().hasOnly([
            'activeSeasonKey',
            'activeSeasonLabel',
            'activeRewardName',
            'activeBadgeLabel',
            'activeTitleLabel',
            'cosmeticFrameLabel',
            'cosmeticAuraLabel',
            'equippedAt',
            'syncSchemaVersion',
            'syncSource',
            'updatedAt'
          ]) &&
          request.resource.data.activeSeasonKey is string &&
          request.resource.data.activeSeasonLabel is string &&
          request.resource.data.activeSeasonLabel.size() <= 24 &&
          request.resource.data.activeRewardName is string &&
          request.resource.data.activeRewardName.size() <= 80 &&
          request.resource.data.activeBadgeLabel is string &&
          request.resource.data.activeBadgeLabel.size() <= 40 &&
          request.resource.data.activeTitleLabel is string &&
          request.resource.data.activeTitleLabel.size() <= 60 &&
          request.resource.data.cosmeticFrameLabel is string &&
          request.resource.data.cosmeticFrameLabel.size() <= 40 &&
          request.resource.data.cosmeticAuraLabel is string &&
          request.resource.data.cosmeticAuraLabel.size() <= 40 &&
          request.resource.data.equippedAt is timestamp &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          request.resource.data.updatedAt is timestamp;
    }

    function validIntegritySnapshot(docId, shouldMatchDocId) {
      return request.resource.data.keys().hasOnly([
            'weekKey',
            'trustScore',
            'trustBand',
            'weeklyActiveDays',
            'weeklyCompetitiveDays',
            'personalQuestCompletionsToday',
            'competitiveQuestCompletionsToday',
            'personalXpToday',
            'competitiveXpToday',
            'suspiciousPatternCount',
            'summary',
            'detail',
            'syncSchemaVersion',
            'syncSource',
            'updatedAt'
          ]) &&
          request.resource.data.weekKey is string &&
          (!shouldMatchDocId || request.resource.data.weekKey == docId) &&
          request.resource.data.trustScore is int &&
          request.resource.data.trustScore >= 0 &&
          request.resource.data.trustScore <= 100 &&
          isValidTrustBand(request.resource.data.trustBand) &&
          request.resource.data.weeklyActiveDays is int &&
          request.resource.data.weeklyActiveDays >= 0 &&
          request.resource.data.weeklyCompetitiveDays is int &&
          request.resource.data.weeklyCompetitiveDays >= 0 &&
          request.resource.data.personalQuestCompletionsToday is int &&
          request.resource.data.personalQuestCompletionsToday >= 0 &&
          request.resource.data.competitiveQuestCompletionsToday is int &&
          request.resource.data.competitiveQuestCompletionsToday >= 0 &&
          request.resource.data.personalXpToday is int &&
          request.resource.data.personalXpToday >= 0 &&
          request.resource.data.competitiveXpToday is int &&
          request.resource.data.competitiveXpToday >= 0 &&
          request.resource.data.suspiciousPatternCount is int &&
          request.resource.data.suspiciousPatternCount >= 0 &&
          request.resource.data.summary is string &&
          request.resource.data.summary.size() <= 80 &&
          request.resource.data.detail is string &&
          request.resource.data.detail.size() <= 500 &&
          request.resource.data.syncSchemaVersion is int &&
          request.resource.data.syncSchemaVersion >= 1 &&
          request.resource.data.syncSchemaVersion <= 3 &&
          isValidSyncSource(request.resource.data.syncSource) &&
          request.resource.data.updatedAt is timestamp;
    }

    function validCompletionPayload(userId) {
      return request.resource.data.keys().hasOnly([
            'uid',
            'displayName',
            'photoUrl',
            'rankAtCompletion',
            'completedAt'
          ]) &&
          request.resource.data.uid == userId &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 40 &&
          request.resource.data.photoUrl is string &&
          request.resource.data.photoUrl.size() <= 500 &&
          isValidRank(request.resource.data.rankAtCompletion) &&
          request.resource.data.completedAt == request.time;
    }

    function validBossCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount']) &&
          resource.data.completedCount is int &&
          request.resource.data.completedCount is int &&
          request.resource.data.completedCount == resource.data.completedCount + 1;
    }

    match /weekly_bosses/{bossId} {
      allow read: if true;
      allow create, delete: if false;

      allow update: if isSignedIn() &&
          validBossCounterUpdate() &&
          !exists(completionPath(bossId, request.auth.uid)) &&
          existsAfter(completionPath(bossId, request.auth.uid));

      match /completions/{userId} {
        allow read: if true;
        allow create: if isSignedIn() &&
            request.auth.uid == userId &&
            !exists(completionPath(bossId, userId)) &&
            validCompletionPayload(userId);
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;

      match /progression/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            docId == 'current' &&
            validProgressionSnapshot(docId, false);
        allow delete: if false;
      }

      match /progression_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validProgressionSnapshot(docId, true);
        allow delete: if false;
      }

      match /promotion_exam/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validPromotionExam(docId);
        allow delete: if false;
      }

      match /season_rewards/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            docId == 'current' &&
            validSeasonReward(docId, false);
        allow delete: if false;
      }

      match /season_reward_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validSeasonReward(docId, true);
        allow delete: if false;
      }

      match /season_legacy/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validSeasonLegacy(docId, true);
        allow delete: if false;
      }

      match /season_profile/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validSeasonProfile(docId);
        allow delete: if false;
      }

      match /integrity/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            docId == 'current' &&
            validIntegritySnapshot(docId, false);
        allow delete: if false;
      }

      match /integrity_history/{docId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() &&
            request.auth.uid == userId &&
            validIntegritySnapshot(docId, true);
        allow delete: if false;
      }
    }
  }
}
